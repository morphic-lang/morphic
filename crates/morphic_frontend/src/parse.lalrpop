use crate::data::builtin_traits::BuiltinTraitFunc as Func;
use crate::data::num_type::NumLit;
use crate::data::purity::Purity;
use crate::data::raw_ast as syntax;
use crate::data::visibility::Visibility;
use crate::lex;

grammar;

// Lexer Integration

extern {
  type Location = usize;
  type Error = lex::Error;

  enum lex::Token {
    "UpperName" => lex::Token::UpperName(<String>),
    "LowerName" => lex::Token::LowerName(<String>),
    "NumLit" => lex::Token::NumLit(<NumLit>),
    "StringLit" => lex::Token::StringLit(<String>),

    "type" => lex::Token::Type,
    "trait" => lex::Token::Trait,
    "impl" => lex::Token::Impl,
    "of" => lex::Token::Of,
    "where" => lex::Token::Where,
    "match" => lex::Token::Match,
    "if" => lex::Token::If,
    "else" => lex::Token::Else,
    "let" => lex::Token::Let,
    "in" => lex::Token::In,
    "proc" => lex::Token::Proc,
    "do" => lex::Token::Do,
    "then" => lex::Token::Then,
    "module" => lex::Token::Module,
    "import" => lex::Token::Import,
    "file" => lex::Token::File,
    "from" => lex::Token::From,
    "expose" => lex::Token::Expose,
    "with" => lex::Token::With,
    "as" => lex::Token::As,
    "pub" => lex::Token::Pub,

    "(" => lex::Token::LParen,
    ")" => lex::Token::RParen,
    "[" => lex::Token::LSquare,
    "]" => lex::Token::RSquare,
    "{" => lex::Token::LCurly,
    "}" => lex::Token::RCurly,

    "," => lex::Token::Comma,
    ":" => lex::Token::Colon,
    "=" => lex::Token::Equal,
    "->" => lex::Token::Arrow,
    "\\" => lex::Token::BackSlash,
    "_" => lex::Token::Underscore,
    "." => lex::Token::Dot,
    "<|" => lex::Token::PipeLeft,
    "|>" => lex::Token::PipeRight,
    "+" => lex::Token::Add,
    "-" => lex::Token::Sub,
    "*" => lex::Token::Mul,
    "/" => lex::Token::Div,
    "<" => lex::Token::Lt,
    "<=" => lex::Token::Lte,
    ">" => lex::Token::Gt,
    ">=" => lex::Token::Gte,

    "!" => lex::Token::Exclamation,
    "&&" => lex::Token::DoubleAmp,
    "||" => lex::Token::DoubleBar,
    "&" => lex::Token::Amp,
    "|" => lex::Token::Bar,
    "^" => lex::Token::Caret,
    "<<" => lex::Token::ShiftLeft,
    ">>" => lex::Token::ShiftRight,
  }
}

// Macros

CommaSep<T>: Vec<T> = {
  <items: (<T> ",")*> <last: T?> => match last {
    None => items,
    Some(item) => {
      let mut result = items;
      result.push(item);
      result
    }
  }
};

Spanned<T>: syntax::Expr = {
  <lo: @L> <expr:T> <hi: @R> => {
    if let syntax::Expr::Span(_, _, _) = &expr {
      expr
    } else {
      syntax::Expr::Span(lo, hi, Box::new(expr))
    }
  },
};

// Names and Strings

#[inline]
TypeName: syntax::TypeName = {
  <"UpperName"> => syntax::TypeName(<>),
};

#[inline]
CtorName: syntax::CtorName = {
  <"UpperName"> => syntax::CtorName(<>),
};

#[inline]
TypeParam: syntax::TypeParam = {
  <"LowerName"> => syntax::TypeParam(<>),
};

#[inline]
ValName: syntax::ValName = {
  <"LowerName"> => syntax::ValName(<>),
};

#[inline]
ModName: syntax::ModName = {
  <"UpperName"> => syntax::ModName(<>),
};

#[inline]
TraitName: syntax::TraitName = {
  <"UpperName"> => syntax::TraitName(<>),
};

#[inline]
ImplName: syntax::ImplName = {
  <"UpperName"> => syntax::ImplName(<>),
};

#[inline]
OptProc: Purity = {
  "proc" => Purity::Impure,
  () => Purity::Pure,
};

#[inline]
OptPub: Visibility = {
  "pub" => Visibility::Public,
  () => Visibility::Private,
}

// Top-Level Items

pub Program: syntax::Program = {
  <Item*> => syntax::Program(<>),
};

Item: syntax::Item = {
  <TypeDef>,
  <ValDef>,
  <TraitDef>,
  <ImplDef>,
  <ModDef>,
  <ModImport>,
  <ModExpose>,
};

// Type Definitions

TypeDef: syntax::Item = {
  <visibility: OptPub> "type" <name: TypeName> <params: TypeParam*> <constrs: WhereClause>
    "{" <cases: CommaSep<TypeCase>> "}" =>
      syntax::Item::TypeDef(visibility, name, params, constrs, cases),
};

TypeCase: (Visibility, syntax::CtorName, Option<syntax::Type>, (usize, usize)) = {
  <lo: @L> <visibility: OptPub> <name: CtorName> <content: ("(" <Types> ")")?> <hi: @R> =>
    (visibility, name, content, (lo, hi)),
};

// Value Definitions

ValDef: syntax::Item = {
  <lo: @L>
  <visibility: OptPub>
  <purity: OptProc>
  <name: ValName>
  "(" <args: CommaSep<(<ValName> ":" <Type>)>> ")"
  ":" <ret_type: Type>
  <constrs: WhereClause>
  "=" <body: Expr>
  <hi: @R> => {
    let (arg_pat, arg_type) = if args.len() == 1 {
      let (arg_name, arg_type) = args.into_iter().next().unwrap();
      (syntax::Pattern::Var(arg_name), arg_type)
    } else {
      let mut pat_items = Vec::new();
      let mut type_items = Vec::new();

      for (pat_item, type_item) in args {
        pat_items.push(syntax::Pattern::Var(pat_item));
        type_items.push(type_item);
      }

      (syntax::Pattern::Tuple(pat_items), syntax::Type::Tuple(type_items))
    };

    let def_type = syntax::Type::Func(purity, Box::new(arg_type), Box::new(ret_type));
    let def_body = syntax::Expr::Lam(purity, arg_pat, Box::new(body));

    syntax::Item::ValDef(visibility, name, def_type, constrs, def_body, (lo, hi))
  },

  <lo: @L> <visibility: OptPub> <name: ValName> ":" <def_type: Type> <constrs: WhereClause>
    "=" <val: Expr> <hi: @R> => {
    syntax::Item::ValDef(visibility, name, def_type, constrs, val, (lo, hi))
  },
}

// Traits and Impls

QualTraitName: (syntax::ModPath, syntax::TraitName) = {
  <path: QualPath> <name: TraitName> =>
    (path, name)
};

TraitApp: syntax::TraitApp = {
  <lo: @L> <name: QualTraitName> <args: AtomicType*> <hi: @R> =>
    syntax::TraitApp { path: name.0, trait_name: name.1, args, span: (lo, hi) },
};

// Two or more constraints must be parenthesized, as in Haskell. This way, a comma after a
// constraint is never confused with the comma separating the funcs of a trait.
ConstrList: Vec<syntax::TraitApp> = {
  <TraitApp> => vec![<>],
  "(" <CommaSep<TraitApp>> ")",
};

WhereClause: Vec<syntax::TraitApp> = {
  <constrs: ("where" <ConstrList>)?> => constrs.unwrap_or_default(),
};

// Desugars a `name(arg: T, ...): R` header into the pattern and function type of the definition
// it declares, exactly as a value definition does.
FuncHeader: (syntax::ValName, syntax::Pattern, syntax::Type) = {
  <purity: OptProc>
  <name: ValName>
  "(" <args: CommaSep<(<ValName> ":" <Type>)>> ")"
  ":" <ret_type: Type> => {
    let (arg_pat, arg_type) = if args.len() == 1 {
      let (arg_name, arg_type) = args.into_iter().next().unwrap();
      (syntax::Pattern::Var(arg_name), arg_type)
    } else {
      let mut pat_items = Vec::new();
      let mut type_items = Vec::new();

      for (pat_item, type_item) in args {
        pat_items.push(syntax::Pattern::Var(pat_item));
        type_items.push(type_item);
      }

      (syntax::Pattern::Tuple(pat_items), syntax::Type::Tuple(type_items))
    };

    let def_type = syntax::Type::Func(purity, Box::new(arg_type), Box::new(ret_type));
    (name, arg_pat, def_type)
  },
};

TraitDef: syntax::Item = {
  <visibility: OptPub> "trait" <name: TraitName> <params: TypeParam*> <supers: WhereClause>
    "{" <funcs: CommaSep<TraitFuncDecl>> "}" =>
      syntax::Item::TraitDef(visibility, name, params, supers, funcs),
};

TraitFuncDecl: syntax::TraitFunc = {
  <lo: @L> <header: FuncHeader> <constrs: WhereClause> <hi: @R> =>
    syntax::TraitFunc { name: header.0, type_: header.2, trait_constrs: constrs, span: (lo, hi) },

  <lo: @L> <name: ValName> ":" <type_: Type> <constrs: WhereClause> <hi: @R> =>
    syntax::TraitFunc { name, type_, trait_constrs: constrs, span: (lo, hi) },
};

// Impl funcs are definitions and so self-delimit, like the definitions of a module. Trait funcs are
// declarations ending in a type, which necessitates a separator, like the variants of a type.
ImplDef: syntax::Item = {
  <visibility: OptPub> "impl" <name: ImplName> "of" <head: TraitApp> <constrs: WhereClause>
    "{" <funcs: ImplFunc*> "}" =>
      syntax::Item::ImplDef(visibility, name, head, constrs, funcs),
};

ImplFunc: syntax::ImplFunc = {
  <lo: @L> <header: FuncHeader> <constrs: WhereClause> "=" <body: Expr> <hi: @R> => {
    let (name, arg_pat, def_type) = header;
    let purity = match &def_type {
      syntax::Type::Func(purity, _, _) => *purity,
      _ => unreachable!(),
    };
    syntax::ImplFunc {
      name,
      type_: def_type,
      trait_constrs: constrs,
      body: syntax::Expr::Lam(purity, arg_pat, Box::new(body)),
      span: (lo, hi),
    }
  },

  <lo: @L> <name: ValName> ":" <type_: Type> <constrs: WhereClause> "=" <body: Expr> <hi: @R> =>
    syntax::ImplFunc { name, type_, trait_constrs: constrs, body, span: (lo, hi) },
};

// Module Defintions

ModDef: syntax::Item = {
  <visibility: OptPub> "module" <name: ModName> "=" <spec: ModSpec>
  <bindings: ("with" "{" <CommaSep<ModBinding>> "}")?>
  <expose: OptExposeSpec> =>
    syntax::Item::ModDef(visibility, name, spec, bindings.unwrap_or_default(), expose),
};

ModImport: syntax::Item = {
  "import" <name: ModName> <expose: OptExposeSpec> =>
    syntax::Item::ModImport(name, expose),
};

ModExpose: syntax::Item = {
  "from" <path: ModPath> <expose: ExposeSpec> =>
    syntax::Item::ModExpose(path, expose),
};

ModSpec: syntax::ModSpec = {
  "file" <path: "StringLit"> =>
    syntax::ModSpec::File(path.split('/').map(|s| s.to_owned()).collect()),

  "{" <Program> "}" => syntax::ModSpec::Inline(<>),
};

ModBinding: syntax::ModBinding = {
  <name: ModName> =>
    syntax::ModBinding {
      name: name.clone(),
      binding: syntax::ModPath(vec![name]),
    },

  <name: ModName> "=" <binding: ModPath> =>
    syntax::ModBinding { name, binding },
};

#[inline]
ModPath: syntax::ModPath = {
  <path: (<ModName> ".")*> <last: ModName> => {
    let mut result = path;
    result.push(last);
    syntax::ModPath(result)
  }
};

#[inline]
QualPath: syntax::ModPath = {
  <(<ModName> ".")*> =>
    syntax::ModPath(<>),
};

// Public for use in parsing '--profile' arguments
pub QualName: (syntax::ModPath, syntax::ValName) = {
  <path: QualPath> <name: ValName> =>
    (path, name),
};

ExposeSpec: syntax::ExposeSpec = {
  // TODO: Add support for glob imports

  "expose" "{" <CommaSep<ExposeItem>> "}" =>
    syntax::ExposeSpec::Specific(<>),
};

OptExposeSpec: syntax::ExposeSpec = {
  <spec: ExposeSpec?> =>
    spec.unwrap_or_else(|| syntax::ExposeSpec::Specific(vec![])),
};

ExposeItem: syntax::ExposeItem = {
  <visibility: OptPub> <name: ValName> => syntax::ExposeItem::Val(visibility, name),

  <visibility: OptPub> <name: TypeName> <ctors: ("{" <CommaSep<(OptPub CtorName)>> "}")?> =>
    syntax::ExposeItem::Type(visibility, name, ctors.unwrap_or_default()),

  <visibility: OptPub> "trait" <name: TraitName> <funcs: ("{" <CommaSep<(OptPub ValName)>> "}")?> =>
    syntax::ExposeItem::Trait(visibility, name, funcs.unwrap_or_default()),

  <visibility: OptPub> "impl" <name: ImplName> =>
    syntax::ExposeItem::Impl(visibility, name),

  <visibility: OptPub> "module" <name: ModName> <expose: OptExposeSpec> =>
    syntax::ExposeItem::Mod(visibility, name, Box::new(expose)),
};

// Types

QualTypeName: (syntax::ModPath, syntax::TypeName) = {
  <path: QualPath> <name: TypeName> =>
    (path, name)
};

SpannedType<T>: syntax::Type = {
  <lo: @L> <type_: T> <hi: @R> => {
    if let syntax::Type::Span(_, _, _) = &type_ {
      type_
    } else {
      syntax::Type::Span(lo, hi, Box::new(type_))
    }
  },
};

AtomicType_: syntax::Type = {
  "(" <Types> ")",
  <TypeParam> => syntax::Type::Var(<>),
  <QualTypeName> => syntax::Type::App(<>.0, <>.1, Vec::new()),
};

AtomicType: syntax::Type = {
  <SpannedType<AtomicType_>>,
};

AppType_: syntax::Type = {
  <AtomicType>,
  <name: QualTypeName> <args: AtomicType+> =>
    syntax::Type::App(name.0, name.1, args),
  <param: TypeParam> <args: AtomicType+> =>
    syntax::Type::AppVar(param, args),
};

AppType: syntax::Type = {
  <SpannedType<AppType_>>,
};

FuncType_: syntax::Type = {
  <AppType>,
  <purity: OptProc> <arg: AppType> "->" <ret: FuncType> =>
    syntax::Type::Func(purity, Box::new(arg), Box::new(ret)),
};

FuncType: syntax::Type = {
  <SpannedType<FuncType_>>,
};

Type: syntax::Type = {
  <FuncType>,
};

Types: syntax::Type = {
  <types: CommaSep<Type>> => {
    if types.len() == 1 {
      types.into_iter().next().unwrap()
    } else {
      syntax::Type::Tuple(types)
    }
  },
};

// Expressions

AtomicExpr_: syntax::Expr = {
  "(" <Exprs> ")",

  <qual_name: QualName> => {
    let (path, name) = qual_name;
    if path.0.is_empty() {
      syntax::Expr::Var(name)
    } else {
      syntax::Expr::QualName(path, name)
    }
  },

  <path: QualPath> <name: CtorName> => syntax::Expr::Ctor(path, name),

  "[" <CommaSep<Expr>> "]" => syntax::Expr::ArrayLit(<>),

  <"NumLit"> => syntax::Expr::NumLit(<>),

  <"StringLit"> => syntax::Expr::TextLit(<>),

  <MatchExpr>,

  <IfExpr>,
};

AtomicExpr: syntax::Expr = {
  <Spanned<AtomicExpr_>>,
};

MatchExpr_: syntax::Expr = {
  "match" <expr: Expr> "{" <cases: CommaSep<(<Pattern> "->" <Expr>)>> "}" =>
    syntax::Expr::Match(Box::new(expr), cases),
};

MatchExpr: syntax::Expr = {
  <Spanned<MatchExpr_>>,
};

IfExpr_: syntax::Expr = {
  "if" <expr: Expr> "{" <if_block: Expr> "}" "else" <else_if_block: IfExpr> =>
    syntax::Expr::Match(
      Box::new(expr),
      vec![
        (
          syntax::Pattern::Ctor(syntax::ModPath(vec![]), syntax::CtorName("True".to_string()), None),
          if_block
        ),
        (
          syntax::Pattern::Ctor(syntax::ModPath(vec![]), syntax::CtorName("False".to_string()), None),
          else_if_block
        )
      ]
    ),
  "if" <expr: Expr> "{" <if_block: Expr> "}" "else" "{" <else_block: Expr> "}" =>
    syntax::Expr::Match(
      Box::new(expr),
      vec![
        (
          syntax::Pattern::Ctor(syntax::ModPath(vec![]), syntax::CtorName("True".to_string()), None),
          if_block
        ),
        (
          syntax::Pattern::Ctor(syntax::ModPath(vec![]), syntax::CtorName("False".to_string()), None),
          else_block
        )
      ]
    ),
};

IfExpr: syntax::Expr = {
  <Spanned<IfExpr_>>,
};

PureAppExpr_: syntax::Expr = {
  <AtomicExpr>,

  <func: PureAppExpr> <lo: @L> "(" <args: CommaSep<Expr>> ")" <hi: @R> =>
    syntax::Expr::App(Purity::Pure, Box::new(func), (lo, hi, args)),
};

PureAppExpr: syntax::Expr = {
  <Spanned<PureAppExpr_>>,
};

AppExpr_: syntax::Expr = {
  <PureAppExpr>,

  "do" <func: AtomicExpr> <lo: @L> "(" <args: CommaSep<Expr>> ")" <hi: @R> =>
    syntax::Expr::App(Purity::Impure, Box::new(func), (lo, hi, args)),
};

AppExpr: syntax::Expr = {
  <Spanned<AppExpr_>>,
};

PrefixExpr_: syntax::Expr = {
  <AppExpr>,

  "-" <PrefixExpr> => syntax::unop(Func::Neg, <>),
  "!" <PrefixExpr> => syntax::unop(Func::Not, <>),
};

PrefixExpr: syntax::Expr = {
  <Spanned<PrefixExpr_>>,
};

ArithProdExpr_: syntax::Expr = {
  <PrefixExpr>,

  <left: ArithProdExpr> "*" <right: AppExpr> => syntax::binop(Func::Mul, left, right),
  <left: ArithProdExpr> "/" <right: AppExpr> => syntax::binop(Func::Div, left, right),
};

ArithProdExpr: syntax::Expr = {
  <Spanned<ArithProdExpr_>>,
};

ArithSumExpr_: syntax::Expr = {
  <ArithProdExpr>,

  <left: ArithSumExpr> "+" <right: ArithProdExpr> => syntax::binop(Func::Add, left, right),
  <left: ArithSumExpr> "-" <right: ArithProdExpr> => syntax::binop(Func::Sub, left, right),
};

ArithSumExpr: syntax::Expr = {
  <Spanned<ArithSumExpr_>>,
};

// TODO: Translating greater-than to less-than reverses the evaluation order of the operands.
// If the operands have side effects, this can alter the program's semantics!
// The bitwise operators sit between the arithmetic and the comparisons, at Rust's precedence:
// shifts bind looser than sums, then `&`, `^`, and `|` in turn.
ShiftExpr_: syntax::Expr = {
  <ArithSumExpr>,

  <left: ShiftExpr> "<<" <right: ArithSumExpr> => syntax::binop(Func::Shl, left, right),
  <left: ShiftExpr> ">>" <right: ArithSumExpr> => syntax::binop(Func::Shr, left, right),
};

ShiftExpr: syntax::Expr = {
  <Spanned<ShiftExpr_>>,
};

BitAndExpr_: syntax::Expr = {
  <ShiftExpr>,

  <left: BitAndExpr> "&" <right: ShiftExpr> => syntax::binop(Func::BitAnd, left, right),
};

BitAndExpr: syntax::Expr = {
  <Spanned<BitAndExpr_>>,
};

BitXorExpr_: syntax::Expr = {
  <BitAndExpr>,

  <left: BitXorExpr> "^" <right: BitAndExpr> => syntax::binop(Func::BitXor, left, right),
};

BitXorExpr: syntax::Expr = {
  <Spanned<BitXorExpr_>>,
};

BitOrExpr_: syntax::Expr = {
  <BitXorExpr>,

  <left: BitOrExpr> "|" <right: BitXorExpr> => syntax::binop(Func::BitOr, left, right),
};

BitOrExpr: syntax::Expr = {
  <Spanned<BitOrExpr_>>,
};

ArithCompExpr_: syntax::Expr = {
  <BitOrExpr>,

  <left: BitOrExpr> "=" <right: BitOrExpr> => syntax::binop(Func::Eq, left, right),
  <left: BitOrExpr> "<" <right: BitOrExpr> => syntax::binop(Func::Lt, left, right),
  <left: BitOrExpr> "<=" <right: BitOrExpr> => syntax::binop(Func::Lte, left, right),
  <left: BitOrExpr> ">" <right: BitOrExpr> => syntax::binop(Func::Gt, left, right),
  <left: BitOrExpr> ">=" <right: BitOrExpr> => syntax::binop(Func::Gte, left, right),
};

ArithCompExpr: syntax::Expr = {
  <Spanned<ArithCompExpr_>>,
};

ArithExpr: syntax::Expr = {
  <ArithCompExpr>,
};

AndExpr_: syntax::Expr = {
  <ArithExpr>,

  <left: AndExpr> "&&" <right: ArithExpr> => syntax::Expr::And(Box::new(left), Box::new(right)),
}

AndExpr: syntax::Expr = {
  <Spanned<AndExpr_>>,
}

OrExpr_: syntax::Expr = {
  <AndExpr>,

  <left: OrExpr> "||" <right: AndExpr> => syntax::Expr::Or(Box::new(left), Box::new(right)),
}

OrExpr: syntax::Expr = {
  <Spanned<OrExpr_>>,
}

PipeRightExpr_: syntax::Expr = {
  <OrExpr>,

  <left: PipeRightExpr> "|>" <right: AppExpr> => syntax::Expr::PipeRight(Box::new(left), Box::new(right)),
}

PipeRightExpr: syntax::Expr = {
  <Spanned<PipeRightExpr_>>,
}

BlockExpr_: syntax::Expr = {
  <PipeRightExpr>,

  <left: PipeRightExpr> "<|" <right: BlockExpr> => syntax::Expr::PipeLeft(Box::new(left), Box::new(right)),

  "let" <lhs: AnnotPattern> "=" <rhs: Expr> "in" <body: BlockExpr> => {
    if let syntax::Expr::Span(left, right, body) = body {
      let new_let_expr = match *body {
        // if we already have a LetMany, prepend `lhs = rhs` onto bindings
        syntax::Expr::LetMany(mut bindings, expr) => {
          bindings.push_front((lhs, rhs));
          syntax::Expr::LetMany(bindings, expr)
        },
        // otherwise create a new LetMany
        _ => syntax::Expr::LetMany(vec![(lhs, rhs)].into(), body),
      };
      syntax::Expr::Span(left, right, Box::new(new_let_expr))
    } else {
      unreachable!();
    }
  },

  <rhs: ArithExpr> "then" <body: BlockExpr> => {
    if let syntax::Expr::Span(left, right, body) = body {
      let new_let_expr = match *body {
        // if we already have a LetMany, prepend `_ = rhs` onto bindings
        syntax::Expr::LetMany(mut bindings, expr) => {
          bindings.push_front((syntax::Pattern::Any, rhs));
          syntax::Expr::LetMany(bindings, expr)
        },
        // otherwise create a new LetMany
        _ => syntax::Expr::LetMany(vec![(syntax::Pattern::Any, rhs)].into(), body),
      };
      syntax::Expr::Span(left, right, Box::new(new_let_expr))
    } else {
      unreachable!();
    }
  },

  <purity: OptProc> "\\" <param: Pattern> "->" <body: BlockExpr> =>
    syntax::Expr::Lam(purity, param, Box::new(body)),
};

BlockExpr: syntax::Expr = {
  <Spanned<BlockExpr_>>,
};

Expr: syntax::Expr = {
  <BlockExpr>,
};

Exprs_: syntax::Expr = {
  <exprs: CommaSep<Expr>> => {
    if exprs.len() == 1 {
      exprs.into_iter().next().unwrap()
    } else {
      syntax::Expr::Tuple(exprs)
    }
  },
};

Exprs: syntax::Expr = {
  <Spanned<Exprs_>>,
};

// Patterns

Pattern_: syntax::Pattern = {
  "(" <Patterns> ")",

  "_" => syntax::Pattern::Any,

  <ValName> => syntax::Pattern::Var(<>),

  <path: QualPath> <ctor: CtorName> =>
    syntax::Pattern::Ctor(path, ctor, None),

  <path: QualPath> <ctor: CtorName> "(" <args: Patterns> ")" =>
    syntax::Pattern::Ctor(path, ctor, Some(Box::new(args))),

  <"NumLit"> => syntax::Pattern::NumConst(<>),
};

Pattern: syntax::Pattern = {
  <lo: @L> <pat: Pattern_> <hi: @R> => {
    if let syntax::Pattern::Span(_, _, _) = &pat {
      pat
    } else {
      syntax::Pattern::Span(lo, hi, Box::new(pat))
    }
  },
};

// A pattern optionally followed by a type annotation, e.g. `x: I64`. Annotations are only
// permitted where the token after the type is unambiguous (`=`, `,` or `)`). A bare `x: a -> b`
// following a lambda or match arm would be ambiguous with a function type.
AnnotPattern: syntax::Pattern = {
  <Pattern>,

  <lo: @L> <pat: Pattern> ":" <type_: Type> <hi: @R> =>
    syntax::Pattern::Span(lo, hi, Box::new(syntax::Pattern::Annot(Box::new(pat), type_))),
};

Patterns_: syntax::Pattern = {
  <patterns: CommaSep<AnnotPattern>> => {
    if patterns.len() == 1 {
      patterns.into_iter().next().unwrap()
    } else {
      syntax::Pattern::Tuple(patterns)
    }
  }
};

Patterns: syntax::Pattern = {
  <lo: @L> <pat: Patterns_> <hi: @R> => {
    if let syntax::Pattern::Span(_, _, _) = &pat {
      pat
    } else {
      syntax::Pattern::Span(lo, hi, Box::new(pat))
    }
  },
};
