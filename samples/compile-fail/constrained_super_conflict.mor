// expect-error: Conflicting Impls @ 41:22
module Traits = {
  pub trait Eq a {
    eq(x: a, y: a): Bool,
  }

  pub trait Ord a where Eq a {
    lt(x: a, y: a): Bool,
  }

  pub impl EqInt of Eq Int {
    eq(x: Int, y: Int): Bool = x = y
  }

  // Its superclass evidence is `EqInt`, the `Eq Int` impl in scope here.
  pub impl OrdInt of Ord Int {
    lt(x: Int, y: Int): Bool = x < y
  }

  pub type Boxed a where Eq a {
    pub Boxed(a)
  }

  pub same(x: Boxed a, y: Boxed a): Bool where Ord a =
    match (x, y) { (Boxed(a), Boxed(b)) -> eq(a, b) }
} expose { trait Eq { eq }, trait Ord { lt }, impl OrdInt, Boxed { Boxed }, same }

module Weird = {
  import Traits expose { trait Eq }

  pub impl EqIntWeird of Eq Int {
    eq(x: Int, y: Int): Bool = False
  }
} with { Traits } expose { impl EqIntWeird }

// The signature of `mk` is elaborated here, where `EqIntWeird` is the `Eq Int` impl in scope,
// but `same` needs a `Boxed Int` whose evidence is the superclass of `OrdInt`, which is `EqInt`.
mk(): Boxed Int = Boxed(1)

proc main(): () =
  let _: Bool = same(mk(), mk()) in
  ()
