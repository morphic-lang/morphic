// expect-error: Partially Applied Constrained Type @ 15:22
trait Ord a {
  lt(x: a, y: a): Bool,
}

pub type Set a where Ord a {
  pub Set(Array a)
}

trait Container f {
  size(x: f a): I64,
}

// A constrained type cannot be applied to fewer arguments than its constraints mention.
impl ContainerSet of Container Set {
  size(x: Set a): I64 = 0
}

proc main(): () = ()
