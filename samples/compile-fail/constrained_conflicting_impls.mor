// expect-error: Conflicting Impls @ 71:21
module Ord = {
  pub trait Ord a {
    lt(x: a, y: a): Bool,
  }

  pub impl OrdI64 of Ord I64 {
    lt(x: I64, y: I64): Bool = x < y
  }

  pub impl OrdI64Rev of Ord I64 {
    lt(x: I64, y: I64): Bool = y < x
  }
} expose { trait Ord { lt }, impl OrdI64 }

module Set = {
  import Ord expose { trait Ord { lt } }

  // A sorted array.  The ordering it is sorted by is part of its type: a `Set I64` built under
  // `OrdI64` is a different type from one built under `OrdI64Rev`.
  pub type Set a where Ord a {
    pub Set(Array a)
  }

  pub empty(): Set a where Ord a = Set([])

  pub insert(s: Set a, x: a): Set a where Ord a =
    match s { Set(arr) -> Set(insert_rec(arr, x, 0, [])) }

  insert_rec(arr: Array a, x: a, i: I64, out: Array a): Array a where Ord a =
    match i < len(arr) {
      False -> push(out, x),
      True ->
        let y = get(arr, i) in
        match lt(x, y) {
          True -> append_from(push(out, x), arr, i),
          False -> insert_rec(arr, x, i + 1, push(out, y)),
        },
    }

  append_from(out: Array a, arr: Array a, i: I64): Array a =
    match i < len(arr) {
      False -> out,
      True -> append_from(push(out, get(arr, i)), arr, i + 1),
    }

  pub to_array(s: Set a): Array a where Ord a =
    match s { Set(arr) -> arr }
} with { Ord } expose { Set { Set }, empty, insert, to_array }

module Fwd = {
  import Ord expose { trait Ord, impl OrdI64 }
  import Set expose { Set { Set }, empty, insert }

  pub make(): Set I64 = insert(insert(insert(empty(), 3), 1), 2)
} with { Ord, Set }

module Rev = {
  import Ord expose { trait Ord, impl OrdI64Rev }
  import Set expose { Set { Set }, empty, insert }

  pub make(): Set I64 = insert(insert(insert(empty(), 3), 1), 2)
} with { Ord, Set }

// The signature of `size` is elaborated in this module, where `OrdI64` is in scope, so it takes
// a `Set I64` built under `OrdI64`; a set built under `OrdI64Rev` is a different type.
size(s: Set I64): I64 =
  len(to_array(s))

proc main(): () =
  let n: I64 = size(Rev.make()) in
  ()
