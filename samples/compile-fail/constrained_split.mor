// expect-error: Constrained Type as Constructor @ 18:25
trait Ord a {
  lt(x: a, y: a): Bool,
}

impl OrdI64 of Ord I64 {
  lt(x: I64, y: I64): Bool = x < y
}

pub type Set a where Ord a {
  pub Set(Array a)
}

keep(x: f I64): f I64 = x

// `Set I64` cannot instantiate the constructor variable `f`.
proc main(): () =
  let s: Set I64 = keep(Set([])) in
  ()
