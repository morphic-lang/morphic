module Core = file "lib/core/core.mor"
  expose {
    module Io,
    module String,
    module Option expose { Option { Some, None } },
    module Iter expose { Iter },
    module Array,
  }
module Parse = file "lib/parse.mor"
  with { Core }
  expose { Parse }
module Bench = file "lib/bench_common.mor"
  with { Core }

type Expr {
  Const(I64),
  Add(Expr, Expr),
  Sub(Expr, Expr),
  Mul(Expr, Expr),
  Div(Expr, Expr),
}

eval(e: Expr): I64 =
  match e {
    Const(x) -> x,
    Add(x, y) -> eval(x) + eval(y),
    Sub(x, y) -> eval(x) - eval(y),
    Mul(x, y) -> eval(x) * eval(y),
    Div(x, y) -> eval(x) / eval(y),
  }

ascii_zero: U8 = 48u8
ascii_nine: U8 = 57u8
ascii_space: U8 = 32u8
ascii_newline: U8 = 10u8
ascii_tab: U8 = 9u8
ascii_asterisk: U8 = 42u8
ascii_slash: U8 = 47u8
ascii_plus: U8 = 43u8
ascii_minus: U8 = 45u8
ascii_open_paren: U8 = 40u8
ascii_close_paren: U8 = 41u8

digit: Parse I64 =
  Parse.u8_range(ascii_zero, ascii_nine)
  |> Parse.map(\x -> u8_to_i64(x - ascii_zero))

i64: Parse I64 =
  Parse.many1_fold(digit, 0, \(x, y) -> x * 10 + y)

space: Parse () =
  (
    Parse.or(Parse.u8_eq(ascii_space)) <|
    Parse.or(Parse.u8_eq(ascii_newline)) <|
    Parse.u8_eq(ascii_tab)
  ) |> Parse.map(\_ -> ())

spaces: Parse () =
  Parse.skip_many0(space)

spaced(p: Parse a): Parse a =
  Parse.skip_pre(spaces) <|
  Parse.skip_post(p, spaces)

atomic_expr: Parse Expr =
  Parse.or(Parse.map(i64, \x -> Const(x))) <|
  Parse.lazy() <| \() ->
  Parse.skip_pre(Parse.u8_eq(ascii_open_paren)) <|
  Parse.skip_post(spaced(expr), Parse.u8_eq(ascii_close_paren))

operator_chain(
  elem: Parse Expr,
  operator: Parse ((Expr, Expr) -> Expr),
): Parse Expr =
  Parse.and_then(elem) <| \lhs ->
  Parse.many0_fold(
    (
      Parse.and_then(spaced(operator)) <| \op ->
      Parse.and_then(elem) <| \rhs ->
      Parse.pure(op, rhs)
    ),
    lhs,
    \(accum, (op, rhs)) -> op(accum, rhs),
  )

mul_level_operator: Parse ((Expr, Expr) -> Expr) =
  Parse.or(Parse.u8_eq(ascii_asterisk) |> Parse.map(\_ -> \x -> Mul(x))) <|
  (Parse.u8_eq(ascii_slash) |> Parse.map(\_ -> \x -> Div(x)))

mul_level_expr: Parse Expr =
  operator_chain(atomic_expr, mul_level_operator)

add_level_operator: Parse ((Expr, Expr) -> Expr) =
  Parse.or(Parse.u8_eq(ascii_plus) |> Parse.map(\_ -> \x -> Add(x))) <|
  (Parse.u8_eq(ascii_minus) |> Parse.map(\_ -> \x -> Sub(x)))

add_level_expr: Parse Expr =
  operator_chain(mul_level_expr, add_level_operator)

expr: Parse Expr =
  spaced(add_level_expr)

eval_exprs(inputs: Iter (Array U8)): Array I64 =
  inputs
  |> Iter.map(\str ->
    str
    |> Parse.parse_all(expr)
    |> Option.unwrap()
    |> eval()
  )
  |> Array.from_iter()

proc read_input_rec(exprs: Array (Array U8)): Array (Array U8) =
  let line = do input() in
  if Array.len(line) = 0 {
    exprs
  } else {
    do read_input_rec(Array.push(exprs, line))
  }

proc read_input(): Array (Array U8) =
  do read_input_rec([])

pub proc main(): () =
  match (String.string_to_nat(do input())) {
    Some(iters) ->
      let exprs = do read_input() in
      match Bench.repeat(iters, \() -> eval_exprs(Iter.items(exprs))) {
        Some(results) ->
          Iter.items(results)
          |> do Iter.for_each(proc \result -> do Io.writeln(String.i64_to_string(result))),
        None -> (),
      },
    None ->
      do Io.writeln("Please enter an iteration count"),
  }
