import Array
import Math expose { rem, i64_bit_not }

// see https://en.wikipedia.org/wiki/Mersenne_Twister
pub type Mt19937_64 {
  Mt19937_64(I64, Array I64)
}

coeff_w: I64 = 64
coeff_n: I64 = 312
coeff_m: I64 = 156
coeff_r: I64 = 31
coeff_a: I64 = -5403634167711393303
coeff_u: I64 = 29
coeff_d: I64 = 6148914691236517205
coeff_s: I64 = 17
coeff_b: I64 = 8202884508482404352
coeff_t: I64 = 37
coeff_c: I64 = -2270628950310912
coeff_l: I64 = 43
coeff_f: I64 = 6364136223846793005

lower_mask: I64 = (1 << coeff_r) - 1
upper_mask: I64 = i64_bit_not(lower_mask)

seed_mt19937_64_rec(accum: Array I64, prev: I64, i: I64, count: I64): Array I64 =
  if i >= count {
    accum
  } else {
    let val = coeff_f * (prev ^ (prev >> (coeff_w - 2))) + i in
    seed_mt19937_64_rec(push(accum, val), val, i + 1, count)
  }

pub seed_mt19937_64(seed: I64): Mt19937_64 =
  Mt19937_64(coeff_n, seed_mt19937_64_rec([seed], seed, 1, coeff_n))

mt19937_64_twist_rec(mt: Array I64, i: I64, count: I64): Array I64 =
  if i >= count {
    mt
  } else {
    let x = (Array.get(mt, i) & upper_mask) +
      (Array.get(mt, rem(i + 1, coeff_n)) & lower_mask) in
    let x_a = if (x & 1) = 0 {
      (x >> 1)
    } else {
      ((x >> 1) ^ coeff_a)
    } in
    let val = Array.get(mt, rem(i + coeff_m, coeff_n)) ^ x_a in
    mt19937_64_twist_rec(Array.set(mt, i, val), i + 1, count)
  }

mt19937_64_twist(gen: Mt19937_64): Mt19937_64 =
  let Mt19937_64(_, mt) = gen in
  Mt19937_64(0, mt19937_64_twist_rec(mt, 0, coeff_n))

pub mt19937_64_next(gen: Mt19937_64): (Mt19937_64, I64) =
  let Mt19937_64(index_, _) = gen in
  let Mt19937_64(index, mt) = if index_ >= coeff_n {
    mt19937_64_twist(gen)
  } else {
    gen
  } in

  let y1 = Array.get(mt, index) in
  let y2 = y1 ^ ((y1 >> coeff_u) & coeff_d) in
  let y3 = y2 ^ ((y2 << coeff_s) & coeff_b) in
  let y4 = y3 ^ ((y3 << coeff_t) & coeff_c) in
  let y5 = y4 ^ (y4 >> coeff_l) in

  (Mt19937_64(index + 1, mt), y5)
