module Core = file "lib/core/core.mor"
  expose { module String expose { i64_to_string, bool_to_string, concat } }

// A type declaration may carry trait constraints.  Every occurrence of such a type carries
// evidence for each of them, so a `Set I64` built under `OrdI64` is a different type from
// one built under `OrdI64Rev`: the evidence is unified along with the type.

module Ord = {
  pub trait Eq a {
    eq(x: a, y: a): Bool,
  }

  pub trait Ord a where Eq a {
    lt(x: a, y: a): Bool,
  }

  pub impl EqI64 of Eq I64 {
    eq(x: I64, y: I64): Bool = x = y
  }

  pub impl OrdI64 of Ord I64 {
    lt(x: I64, y: I64): Bool = x < y
  }

  pub impl OrdI64Rev of Ord I64 {
    lt(x: I64, y: I64): Bool = y < x
  }
} expose { trait Eq { eq }, trait Ord { lt }, impl EqI64, impl OrdI64 }

module Set = {
  import Ord expose { trait Ord { lt } }

  // A sorted array.  The ordering it is sorted by is part of its type.
  pub type Set a where Ord a {
    pub Set(Array a)
  }

  pub empty(): Set a where Ord a = Set([])

  pub insert(s: Set a, x: a): Set a where Ord a =
    match s { Set(arr) -> Set(insert_rec(arr, x, 0, [])) }

  insert_rec(arr: Array a, x: a, i: I64, out: Array a): Array a where Ord a =
    match i < len(arr) {
      False -> push(out, x),
      True ->
        let y = get(arr, i) in
        match lt(x, y) {
          True -> append_from(push(out, x), arr, i),
          False -> insert_rec(arr, x, i + 1, push(out, y)),
        },
    }

  append_from(out: Array a, arr: Array a, i: I64): Array a =
    match i < len(arr) {
      False -> out,
      True -> append_from(push(out, get(arr, i)), arr, i + 1),
    }

  pub to_array(s: Set a): Array a where Ord a =
    match s { Set(arr) -> arr }
} with { Ord } expose { Set { Set }, empty, insert, to_array }

// The same code builds a differently ordered set in a module where a different impl is in scope.
module Fwd = {
  import Ord expose { trait Ord, impl OrdI64 }
  import Set expose { Set { Set }, empty, insert }

  pub make(): Set I64 = insert(insert(insert(empty(), 3), 1), 2)
} with { Ord, Set }

module Rev = {
  import Ord expose { trait Ord, impl OrdI64Rev }
  import Set expose { Set { Set }, empty, insert }

  pub make(): Set I64 = insert(insert(insert(empty(), 3), 1), 2)
} with { Ord, Set }

// A type constrained by a superclass: in `same`, the evidence for `Boxed a` is the `Eq a`
// superclass of the `Ord a` constraint.
type Boxed a where Eq a {
  Boxed(a)
}

same(x: Boxed a, y: Boxed a): Bool where Ord a =
  match (x, y) { (Boxed(a), Boxed(b)) -> eq(a, b) }

// A constrained constructor applied to the parameters its constraints mention carries all of
// its evidence, so it can stand for a type constructor variable: `Map k`'s only constraint is
// `Ord k`, so `Map k` is a `Functor` over its values.
type Map k v where Ord k {
  Map(Array (k, v))
}

trait Functor f {
  map(x: f a, g: a -> b): f b,
}

impl FunctorMap of Functor (Map k) where Ord k {
  map(x: Map k a, g: a -> b): Map k b =
    match x { Map(pairs) -> Map(map_pairs(pairs, g, 0, [])) }
}

// A constraint can be all that determines a parameter's kind: `f` occurs in no variant of
// `Marker`, and gets the kind `Type -> Type` from `Functor f`.
type Marker f where Functor f {
  Marker
}

mark(): Marker (Map I64) = Marker

map_pairs(pairs: Array (k, a), g: a -> b, i: I64, out: Array (k, b)): Array (k, b) =
  match i < len(pairs) {
    False -> out,
    True ->
      let (key, value) = get(pairs, i) in
      map_pairs(pairs, g, i + 1, push(out, (key, g(value)))),
  }

values(m: Map k v): Array v where Ord k =
  match m { Map(pairs) -> values_rec(pairs, 0, []) }

values_rec(pairs: Array (k, v), i: I64, out: Array v): Array v =
  match i < len(pairs) {
    False -> out,
    True ->
      let (_, value) = get(pairs, i) in
      values_rec(pairs, i + 1, push(out, value)),
  }

render(arr: Array I64, i: I64, acc: Array U8): Array U8 =
  match i < len(arr) {
    False -> acc,
    True ->
      let sep = match i = 0 { True -> "", False -> " " } in
      render(arr, i + 1, concat(acc, concat(sep, i64_to_string(get(arr, i))))),
  }

// The evidence a set carries flows into the constraint of a generic function, so a set built
// under either ordering can be passed to `to_array`, whichever impl is in scope here.
proc main(): () =
  let _ = do output(render(to_array(Fwd.make()), 0, "")) in
  let _ = do output("\n") in
  let _ = do output(render(to_array(Rev.make()), 0, "")) in
  let _ = do output("\n") in
  let _ = do output(bool_to_string(same(Boxed(1), Boxed(1)))) in
  let _ = do output("\n") in
  let m: Map I64 I64 = Map([(1, 10), (2, 20)]) in
  let _ = do output(render(values(map(m, \v -> v + 1)), 0, "")) in
  do output("\n")
