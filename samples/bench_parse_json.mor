module Core = file "lib/core/core.mor"
  expose {
    module Io,
    module String,
    module Option expose { Option { Some, None } },
    module Math expose { f64_pow },
    module Array,
    module Iter expose { Iter },
    module Control,
    module State expose { State },
  }
module Parse = file "lib/parse.mor"
  with { Core }
  expose { Parse }
module Bench = file "lib/bench_common.mor"
  with { Core }

ascii_zero: U8 = 48u8
ascii_nine: U8 = 57u8
ascii_space: U8 = 32u8
ascii_line_feed: U8 = 10u8
ascii_carriage_return: U8 = 13u8
ascii_tab: U8 = 9u8
ascii_plus: U8 = 43u8
ascii_minus: U8 = 45u8
ascii_dot: U8 = 46u8
ascii_e: U8 = 101u8
ascii_E: U8 = 69u8
ascii_backslash: U8 = 92u8
ascii_quote: U8 = 34u8
ascii_slash: U8 = 47u8
ascii_b: U8 = 98u8
ascii_backspace: U8 = 8u8
ascii_f: U8 = 102u8
ascii_form_feed: U8 = 12u8
ascii_n: U8 = 110u8
ascii_u: U8 = 117u8
ascii_a: U8 = 97u8
ascii_A: U8 = 65u8
ascii_F: U8 = 70u8
ascii_r: U8 = 114u8
ascii_t: U8 = 116u8
ascii_left_square_bracket: U8 = 91u8
ascii_right_square_bracket: U8 = 93u8
ascii_left_curly_bracket: U8 = 123u8
ascii_right_curly_bracket: U8 = 125u8
ascii_comma: U8 = 44u8
ascii_colon: U8 = 58u8

digit: Parse I64 =
  Parse.u8_range(ascii_zero, ascii_nine)
  |> Parse.map(\x -> u8_to_i64(x - ascii_zero))

hex_digit: Parse I64 =
  Parse.or(Parse.map(Parse.u8_range(ascii_zero, ascii_nine), \d -> u8_to_i64(d - ascii_zero))) <|
  Parse.or(Parse.map(Parse.u8_range(ascii_A, ascii_F), \d -> u8_to_i64(d - ascii_A) + 10)) <|
  Parse.map(Parse.u8_range(ascii_a, ascii_f), \d -> u8_to_i64(d - ascii_a) + 10)

i64: Parse I64 =
  Parse.skip_pre(Parse.not_followed_by(Parse.u8_eq(ascii_zero))) <|
  Parse.many1_fold(digit, 0, \(accum, d) -> accum * 10 + d)

fractional_part: Parse F64 =
  Parse.skip_pre(Parse.u8_eq(ascii_dot)) <|
  Parse.map(
    Parse.many1_fold(
      digit,
      (0.0, 0.1),
      \((accum, place), d) -> (accum + i64_to_f64(d) * place, place / 10.0)
    ),
    \(accum, _) -> accum,
  )

opt_sign: Parse I64 =
  Parse.or(Parse.skip_pre(Parse.u8_eq(ascii_minus), Parse.pure(-1))) <|
  Parse.or(Parse.skip_pre(Parse.u8_eq(ascii_plus), Parse.pure(1))) <|
  Parse.pure(1)

exponent_part: Parse F64 =
  Parse.skip_pre(Parse.or(Parse.u8_eq(ascii_e), Parse.u8_eq(ascii_E))) <|
  Parse.and_then(opt_sign) <| \sign ->
  Parse.and_then(i64) <| \exp ->
  Parse.pure(f64_pow(10.0, sign * exp))

opt_minus: Parse F64 =
  Parse.or(Parse.skip_pre(Parse.u8_eq(ascii_minus), Parse.pure(-1.0))) <|
  Parse.pure(1.0)

number: Parse F64 =
  Parse.and_then(opt_minus) <| \sign ->
  Parse.and_then(i64) <| \i64_part ->
  Parse.and_then(Parse.or(fractional_part, Parse.pure(0.0))) <| \frac_part ->
  Parse.and_then(Parse.or(exponent_part, Parse.pure(1.0))) <| \exp_part ->
  Parse.pure(sign * (i64_to_f64(i64_part) + frac_part) * exp_part)

space: Parse () =
  Parse.skip_post(Parse.pure(())) <|
  Parse.or(Parse.u8_eq(ascii_space)) <|
  Parse.or(Parse.u8_eq(ascii_line_feed)) <|
  Parse.or(Parse.u8_eq(ascii_carriage_return)) <|
  Parse.u8_eq(ascii_tab)

spaces: Parse () =
  Parse.skip_many0(space)

spaced(p: Parse a): Parse a =
  Parse.between(spaces, spaces, p)

parse_ascii_escape: Parse U8 =
  Parse.skip_pre(Parse.u8_eq(ascii_backslash)) <|
  Parse.or(Parse.skip_pre(Parse.u8_eq(ascii_quote), Parse.pure(ascii_quote))) <|
  Parse.or(Parse.skip_pre(Parse.u8_eq(ascii_backslash), Parse.pure(ascii_backslash))) <|
  // why does JSON let you escape a forward slash?
  Parse.or(Parse.skip_pre(Parse.u8_eq(ascii_slash), Parse.pure(ascii_slash))) <|
  Parse.or(Parse.skip_pre(Parse.u8_eq(ascii_b), Parse.pure(ascii_backspace))) <|
  Parse.or(Parse.skip_pre(Parse.u8_eq(ascii_f), Parse.pure(ascii_form_feed))) <|
  Parse.or(Parse.skip_pre(Parse.u8_eq(ascii_n), Parse.pure(ascii_line_feed))) <|
  Parse.or(Parse.skip_pre(Parse.u8_eq(ascii_r), Parse.pure(ascii_carriage_return))) <|
  Parse.skip_pre(Parse.u8_eq(ascii_t), Parse.pure(ascii_tab))

parse_16_bit_unicode_escape: Parse I64 =
  Parse.skip_pre(Parse.u8_eq(ascii_backslash)) <|
  Parse.skip_pre(Parse.u8_eq(ascii_u)) <|
  Parse.and_then(hex_digit) <| \d1 ->
  Parse.and_then(hex_digit) <| \d2 ->
  Parse.and_then(hex_digit) <| \d3 ->
  Parse.and_then(hex_digit) <| \d4 ->
  Parse.pure(d1 * 16 * 16 * 16 + d2 * 16 * 16 + d3 * 16 + d4)

parse_unicode_escape: Parse I64 =
  Parse.and_then(parse_16_bit_unicode_escape) <| \code_unit ->
  // Check if this is the first code unit of a surrogate pair
  if 55296 <= code_unit && code_unit < 56320 {
    Parse.and_then(parse_16_bit_unicode_escape) <| \code_unit2 ->
    if 56320 <= code_unit2 && code_unit2 < 57344 {
      Parse.pure(65536 + (code_unit - 55296) * 1024 + (code_unit2 - 56320))
    } else {
      Parse.fail
    }
  } else {
    Parse.pure(code_unit)
  }

encode_utf8(s: Array U8, x: I64): Array U8 =
  if x < 128 {
    s
    |> Array.push(i64_to_u8(x))
  } else if x < 2048 {
    s
    |> Array.push(i64_to_u8(192 | (x >> 6)))
    |> Array.push(i64_to_u8(128 | (x & 63)))
  } else if x < 65536 {
    s
    |> Array.push(i64_to_u8(224 | (x >> 12)))
    |> Array.push(i64_to_u8(128 | ((x >> 6) & 63)))
    |> Array.push(i64_to_u8(128 | (x & 63)))
  } else if x < 2097152 {
    s
    |> Array.push(i64_to_u8(240 | (x >> 18)))
    |> Array.push(i64_to_u8(128 | ((x >> 12) & 63)))
    |> Array.push(i64_to_u8(128 | ((x >> 6) & 63)))
    |> Array.push(i64_to_u8(128 | (x & 63)))
  } else if x < 67108864 {
    s
    |> Array.push(i64_to_u8(248 | (x >> 24)))
    |> Array.push(i64_to_u8(128 | ((x >> 18) & 63)))
    |> Array.push(i64_to_u8(128 | ((x >> 12) & 63)))
    |> Array.push(i64_to_u8(128 | ((x >> 6) & 63)))
    |> Array.push(i64_to_u8(128 | (x & 63)))
  } else {
    s
    |> Array.push(i64_to_u8(252 | (x >> 30)))
    |> Array.push(i64_to_u8(128 | ((x >> 24) & 63)))
    |> Array.push(i64_to_u8(128 | ((x >> 18) & 63)))
    |> Array.push(i64_to_u8(128 | ((x >> 12) & 63)))
    |> Array.push(i64_to_u8(128 | ((x >> 6) & 63)))
    |> Array.push(i64_to_u8(128 | (x & 63)))
  }

string: Parse (Array U8) =
  Parse.lazy() <| \() ->
  Parse.between(Parse.u8_eq(ascii_quote), Parse.u8_eq(ascii_quote)) <|
  Parse.many0_fold(
    Parse.or(
      Parse.u8
      |> Parse.guard(\x -> x >= 20u8 && ! (x = ascii_quote || x = ascii_backslash))
      |> Parse.map(\x -> \s -> Array.push(s, x)),
    ) <|
    Parse.or(Parse.map(parse_ascii_escape, \x -> \s -> Array.push(s, x))) <|
    Parse.map(parse_unicode_escape, \x -> \s -> encode_utf8(s, x)),
    "",
    \(s, f) -> f(s),
  )

type Value {
  Null,
  Bool(Bool),
  Number(F64),
  String(Array U8),
  Array(Array Value),
  Object(Array (Array U8, Value)),
}

null: Parse () =
  Parse.lazy(\() -> Parse.skip_pre(Parse.lit("null"), Parse.pure(())))

bool: Parse Bool =
  Parse.lazy() <| \() ->
  Parse.or(
    Parse.skip_pre(Parse.lit("true"), Parse.pure(True)),
    Parse.skip_pre(Parse.lit("false"), Parse.pure(False)),
  )

value: Parse Value =
  Parse.lazy() <| \() ->
  Parse.or(Parse.map(number, \x -> Number(x))) <|
  Parse.or(Parse.map(string, \x -> String(x))) <|
  Parse.or(Parse.map(array, \x -> Array(x))) <|
  Parse.or(Parse.map(object, \x -> Object(x))) <|
  Parse.or(Parse.map(null, \() -> Null)) <|
  Parse.map(bool, \x -> Bool(x))

array: Parse (Array Value) =
  Parse.between(Parse.u8_eq(ascii_left_square_bracket), Parse.u8_eq(ascii_right_square_bracket)) <|
  spaced() <|
  Parse.sep0(value, spaced(Parse.u8_eq(ascii_comma)))

object: Parse (Array (Array U8, Value)) =
  Parse.between(Parse.u8_eq(ascii_left_curly_bracket), Parse.u8_eq(ascii_right_curly_bracket)) <|
  spaced() <|
  Parse.sep0(
    Parse.and_then(string) <| \k ->
    Parse.and_then(spaced(Parse.u8_eq(ascii_colon))) <| \_ ->
    Parse.and_then(value) <| \v ->
    Parse.pure((k, v)),
    spaced(Parse.u8_eq(ascii_comma)),
  )

parse_json(s: Array U8): Option Value =
  Parse.parse_all(s, spaced(value))

hash_combine(a: I64, b: I64): I64 =
  (a ^ (b + 2654435769 + (a << 6) + (a >> 2)))

update_hash(x: I64): State I64 () =
  State.modify(\h -> hash_combine(h, x))

hash_string(s: Array U8): State I64 () =
  State.seq(update_hash(Array.len(s))) <|
  State.for_each(Iter.items(s), \x -> update_hash(u8_to_i64(x)))

hash_value(val: Value): State I64 () =
  match val {
    Null -> update_hash(0),
    Bool(b) -> update_hash(if b { 1 } else { 2 }),
    Number(n) -> update_hash(3), // TODO: consider the numerical value when computing the hash
    String(s) ->
      State.seq(update_hash(4)) <|
      hash_string(s),
    Array(a) ->
      State.seq(update_hash(5)) <|
      State.seq(update_hash(Array.len(a))) <|
      State.for_each(Iter.items(a), hash_value),
    Object(o) ->
      State.seq(update_hash(6)) <|
      State.seq(update_hash(Array.len(o))) <|
      State.for_each(Iter.items(o), \(k, v) ->
        State.seq(hash_string(k)) <|
        hash_value(v),
      ),
  }

proc read_input_rec(content: Array U8): Array U8 =
  let line = do input() in
  if Array.len(line) = 0 {
    content
  } else {
    content
    |> Array.concat(line)
    |> Array.push(ascii_line_feed)
    |> do read_input_rec()
  }

proc read_input(): Array U8 =
  do read_input_rec("")

pub proc main(): () =
  match (String.string_to_nat(do input())) {
    Some(iters) ->
      let content = do read_input() in
      match Bench.repeat(iters, \() -> parse_json(content)) {
        Some(None) -> do Io.writeln("Invalid JSON"),
        Some(Some(json)) ->
          let (hash, ()) = State.run(hash_value(json), 0) in
          do Io.writeln(String.i64_to_string(hash)),
        None -> (),
      },
    None ->
      do Io.writeln("Please enter an iteration count"),
  }
